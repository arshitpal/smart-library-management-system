PORT=5000
CLIENT_ORIGIN=http://localhost:5180

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smart_library
DB_USER=root
DB_PASSWORD=change_me
# Must match the MySQL server's time zone
DB_TIMEZONE=+05:30
# Hosted MySQL only: set DB_SSL=true and paste the CA certificate into DB_SSL_CA
DB_SSL=false
DB_SSL_CA=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_value
JWT_EXPIRES_IN=8h

ML_SERVICE_URL=http://127.0.0.1:8001
# Must equal SERVICE_KEY in ml-service/.env
ML_SERVICE_KEY=change_me_too
ML_TIMEOUT_MS=3000
